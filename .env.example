# Alternative Generic VTU Provider (Optional)
VTU_PROVIDER_BASE_URL=
VTU_PROVIDER_API_KEY=
VTU_PROVIDER_USERNAME=
VTU_PROVIDER_PASSWORD=

# Payment Gateways
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
