# VTpass (Electricity, Cable TV, Exam PINs, Alternative Airtime)
VTPASS_BASE_URL=https://api-service.vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

# Termii (Bulk SMS Gateway)
TERMII_BASE_URL=https://api.ng.termii.com/api
TERMII_API_KEY=
