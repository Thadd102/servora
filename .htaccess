# Disable directory browsing and MultiViews
Options -Indexes -MultiViews

# Hide server version banner
ServerSignature Off

# Character encoding
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow Let's Encrypt / cPanel AutoSSL challenge verification
    RewriteRule ^\.well-known(?:$|/) - [L]

    # Block access to hidden files and directories (.env, .git, etc.)
    RewriteRule (^\.|/\.) - [F,L]

    # Block direct access to sensitive internal directories
    RewriteRule ^(database|scratch|docs)/ - [F,L]

    # Automatic HTTPS redirection (safe for direct TLS and upstream reverse proxies)
    RewriteCond %{HTTPS} !on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP:X-Forwarded-SSL} !on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Block sensitive configuration, dependency, database, documentation, and test files
<FilesMatch "^(\.env.*|\.user\.ini|\.git.*|composer\.(json|lock)|package(-lock)?\.json|tailwind\.config\.js|.*\.sql|.*\.md|.*\.log|.*\.bak|.*\.backup|test_.*\.php|scratch_audit\.php|diagnose\.php)$">
    Require all denied
</FilesMatch>

# Security HTTP response headers
<IfModule mod_headers.c>
    # Enforce HSTS now that SSL certificate is active
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set X-XSS-Protection "1; mode=block"

    <FilesMatch "\.(ico|pdf|jpg|jpeg|png|gif|webp|js|css|svg|woff|woff2)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
</IfModule>

# Gzip / Deflate compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser cache expiration headers
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType font/woff "access plus 30 days"
</IfModule>

# PHP engine error suppression for mod_php environments (PHP-FPM is handled via .user.ini)
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag expose_php Off
</IfModule>
